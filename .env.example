# Copy this file to .env and fill in your own values.
# Never commit the real .env file or real keys.

# ---------------------------------------------------------------------
# 1. Web search (required)
# Get a free key at https://app.tavily.com
# ---------------------------------------------------------------------
TAVILY_API_KEY=your-tavily-api-key-here

# ---------------------------------------------------------------------
# 2. The AI model -- pick ONE of the three options below.
# ---------------------------------------------------------------------

# --- Option A: Google Gemini (free tier available) ---
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=your-gemini-api-key-here

# --- Option B: OpenAI (or any OpenAI-compatible endpoint) ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here
# Only set this if you were given a custom endpoint / base URL:
# OPENAI_BASE_URL=https://your-custom-endpoint/v1

# --- Option C: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------
# 3. Optional: override where the SQLite databases are written.
# ---------------------------------------------------------------------
# RESEARCHMATE_MEMORY_DB=data/memory.sqlite
# RESEARCHMATE_CHECKPOINT_DB=data/checkpoints.sqlite
