# Copy this file to .env and paste your keys in.
# Never commit the real .env file or real keys.
#
# You only need to fill in the two lines marked PASTE YOUR ... below.

# ---------------------------------------------------------------------
# 1. Web search (required)
# Get a free key at https://app.tavily.com -- it starts with "tvly-"
# ---------------------------------------------------------------------
TAVILY_API_KEY=PASTE-YOUR-TAVILY-KEY-HERE

# ---------------------------------------------------------------------
# 2. The AI model
#
# Default below is the Sprints LiteLLM gateway, which speaks the OpenAI
# format. Run `python check_setup.py` after filling this in -- it will
# list the exact model names the gateway offers and tell you if LLM_MODEL
# needs changing.
# ---------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://management.sprints.ai/litellm
LLM_MODEL=gemini-2.0-flash
OPENAI_API_KEY=PASTE-YOUR-SPRINTS-KEY-HERE

# --- Alternative: Google Gemini directly (not through a gateway) ---
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=your-gemini-api-key-here

# --- Alternative: OpenAI directly ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-api-key-here

# --- Alternative: Anthropic Claude ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-latest
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------
# 3. Optional: override where the SQLite databases are written.
# ---------------------------------------------------------------------
# RESEARCHMATE_MEMORY_DB=data/memory.sqlite
# RESEARCHMATE_CHECKPOINT_DB=data/checkpoints.sqlite
