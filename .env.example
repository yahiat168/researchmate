# Copy this file to .env and fill in your own values.
# Never commit the real .env file or real keys.

# Required: web search
TAVILY_API_KEY=your-tavily-api-key-here

# Choose one LLM provider and set its key. LLM_PROVIDER selects which one
# the app uses (default: openai).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key-here

# If you set LLM_PROVIDER=anthropic instead, set this and change
# LLM_MODEL to an Anthropic model such as claude-3-5-haiku-latest.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override where the SQLite databases are written.
# RESEARCHMATE_MEMORY_DB=data/memory.sqlite
# RESEARCHMATE_CHECKPOINT_DB=data/checkpoints.sqlite
